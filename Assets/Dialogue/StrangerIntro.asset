  m_Script: {fileID: 11500000, guid: 7d3e1b9a4c5f4e6a8b2d9c1f0a3e5b72, type: 3}
  m_Name: StrangerIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  lines:
  - speaker: 
    text: You shouldn't be here after dark.
    profile: {fileID: 11400000, guid: c4e7a2189b0d4a5f8e3b6d1a9f27c504, type: 2}
    voice: {fileID: 0}
  - speaker: 
    text: The last train left hours ago... <i>or so they say.</i>
    profile: {fileID: 11400000, guid: c4e7a2189b0d4a5f8e3b6d1a9f27c504, type: 2}
    voice: {fileID: 0}
  choices:
  - text: Where is the train?
    next: {fileID: 11400000, guid: 91d0b5e3a7c24f68b4e1d9a03c5f7e26, type: 2}
  - text: Who are you?
    next: {fileID: 11400000, guid: e3a65f1b8d9c4207a1b4c8d2f6e09a73, type: 2}
  - text: Say something.
    next: {fileID: 11400000, guid: 3e9a5c71d2b84f06b8a14d7c6f20e395, type: 2}
  - text: Leave.
    next: {fileID: 0}
  next: {fileID: 0}
